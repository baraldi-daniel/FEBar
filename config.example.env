# Fundalis IA — configuração única do bootstrap.
# Copie para config.env, ajuste e rode:  python3 bootstrap.py
# Tudo o que é gerado no workspace (host do Lakebase, service principal do app, id do Genie, URL…) o bootstrap
# descobre sozinho e grava em .env (usado pelos scripts de evidência). Nenhum segredo vai neste arquivo:
# a autenticação é a do perfil do Databricks CLI (`databricks auth login --host <url> --profile <perfil>`).

# --- workspace ---
DATABRICKS_CONFIG_PROFILE=meu-perfil
# vazio = o bootstrap escolhe um SQL warehouse serverless existente
WAREHOUSE_ID=

# --- Unity Catalog ---
CATALOG=dadosapp
# opcional: só se o catálogo ainda não existir e o metastore exigir local de armazenamento (ex.: s3://bucket/path)
CATALOG_STORAGE_ROOT=
SCHEMA=fundalis_ia
CDC_SCHEMA=fundalis_cdc

# --- Lakebase (Postgres) ---
LAKEBASE_PROJECT=fundalis-ia

# --- AI Gateway ---
# model service do agente (fica em CATALOG.SCHEMA; a inference table vira <nome>_payload)
AGENT_SERVICE_NAME=fundalis_agente
# modelo de fundação por trás do model service
AGENT_FOUNDATION_MODEL=system.ai.databricks-claude-opus-4-8
# embeddings (1024 dimensões) via AI Gateway
EMB_SERVICE=system.ai.qwen3-embedding-0-6b

# --- Model Serving (modelo de rechupe) ---
RECHUPE_ENDPOINT=fundalis_rechupe

# --- Databricks App ---
APP_NAME=fundalis-ia
APP_TITLE=Fundalis IA
GENIE_TITLE=Fundalis IA — Vendas, Leads & Documentos
# pasta do workspace onde vão o código do app e o notebook (vazio = /Workspace/Users/<você>/<APP_NAME>)
WORKSPACE_DIR=

# --- governança ---
# quem vê PII em claro (e-mails/grupos separados por vírgula); vazio = todos veem mascarado
PII_USERS=
# usuários/grupos que podem consultar os dados do app on-behalf-of (recebem USE/SELECT/EXECUTE no schema)
APP_USERS=
